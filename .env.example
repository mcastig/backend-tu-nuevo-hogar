# WhatsApp Cloud API (Meta for Developers)
VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
# App Secret de la app de Meta: activa la validacion de firma de los webhooks
WHATSAPP_APP_SECRET=

# Token de Hugging Face con acceso a meta-llama/Llama-Prompt-Guard-2-86M (sin el, solo corre Llama Guard)
HF_TOKEN=

# Habilita GET /metricas (Authorization: Bearer <token>)
ADMIN_TOKEN=

# Authtoken de ngrok (dashboard.ngrok.com > Your Authtoken): solo lo usa el tunel de Docker (--profile tunel)
NGROK_AUTHTOKEN=

# Opcionales (valores por defecto)
# LLAMA_STACK_URL=http://localhost:8321
# OLLAMA_HOST=http://localhost:11434
# DATABASE_PATH=data/bot.sqlite3
# PORT=8000
